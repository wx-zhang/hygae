index 0000000000000000000000000000000000000000..5dea396525f94fbbdd403d75e700833c4208bb75
--- /dev/null
+++ b/verl/utils/value_head_init.py
@@ -0,0 +1,86 @@
+"""Deterministic normal initialization for PPO critic value heads."""
+
+from __future__ import annotations
+
+import hashlib
+import math
+from typing import Any
+
+import torch
+from torch import nn
+
+
+VALUE_HEAD_INIT_SEED = 42
+DEFAULT_VALUE_HEAD_INIT_STD = 2.0e-3
+
+
+def _find_value_head(model: nn.Module) -> tuple[str, nn.Linear]:
+    score = getattr(model, "score", None)
+    if isinstance(score, nn.Linear):
+        return "score", score
+
+    value_head = getattr(model, "v_head", None)
+    if isinstance(value_head, nn.Linear):
+        return "v_head", value_head
+    summary = getattr(value_head, "summary", None)
+    if isinstance(summary, nn.Linear):
+        return "v_head.summary", summary
+
+    raise ValueError(
+        "critic model does not expose a supported linear value head "
+        "(expected score, v_head, or v_head.summary)"
+    )
+
+
+def _tensor_sha256(tensor: torch.Tensor | None) -> str | None:
+    if tensor is None:
+        return None
+    value = tensor.detach().cpu().contiguous().view(torch.uint8)
+    return hashlib.sha256(value.numpy().tobytes()).hexdigest()
+
+
+def initialize_value_head(
+    model: nn.Module,
+    std: float = DEFAULT_VALUE_HEAD_INIT_STD,
+) -> dict[str, Any]:
+    """Initialize the critic head with N(0, ``std``) and zero bias.
+
+    A private generator with a fixed seed is used so initialization is
+    reproducible without consuming or reseeding the process-global RNG.
+    """
+
+    std = float(std)
+    if not math.isfinite(std) or std <= 0:
+        raise ValueError("value-head init std must be finite and positive")
+
+    name, head = _find_value_head(model)
+    if head.weight.is_meta:
+        raise ValueError(
+            "value-head initialization must run after materialization and before FSDP wrapping"
+        )
+
+    generator = torch.Generator(device=head.weight.device)
+    generator.manual_seed(VALUE_HEAD_INIT_SEED)
+    with torch.no_grad():
+        nn.init.normal_(head.weight, mean=0.0, std=std, generator=generator)
+        if head.bias is not None:
+            nn.init.zeros_(head.bias)
+
+    weight = head.weight.detach().float()
+    bias = head.bias.detach().float() if head.bias is not None else None
+    return {
+        "initializer": "normal",
+        "head": name,
+        "std": std,
+        "seed": VALUE_HEAD_INIT_SEED,
+        "weight_shape": list(head.weight.shape),
+        "weight_dtype": str(head.weight.dtype),
+        "weight_device": str(head.weight.device),
+        "weight_mean": weight.mean().item(),
+        "weight_std": weight.std(unbiased=False).item(),
+        "weight_l2": torch.linalg.vector_norm(weight).item(),
+        "weight_sha256": _tensor_sha256(head.weight),
+        "bias_mean": bias.mean().item() if bias is not None else None,
+        "bias_std": bias.std(unbiased=False).item() if bias is not None else None,
+        "bias_sha256": _tensor_sha256(head.bias),
+    }
